<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="interactivemapuniandes.view.ManageClassesActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbarlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_color"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingtoolbarlayout"
            style="?attr/collapsingToolbarLayoutMediumStyle"
            android:layout_width="match_parent"
            android:layout_height="?attr/collapsingToolbarLayoutMediumSize"
            android:background="@color/background_color"
            app:collapsedSubtitleTextColor="@color/black"
            app:collapsedTitleTextColor="@color/black"
            app:expandedSubtitleTextColor="@color/black"
            app:expandedTitleGravity="bottom|center_horizontal"
            app:expandedTitleTextColor="@color/black"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:subtitle="You will be able to see it on your schedule"
            app:title="Add Class">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Widget.Material3.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/background_color"
                android:elevation="0dp"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/arrow_back_25dp_e3e3e3_fill0_wght400_grad0_opsz24"
                app:navigationIconTint="@color/black"
                app:subtitleTextColor="@color/black"
                app:titleTextColor="@color/black" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/class_form_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/basic_information_card"
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/app_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/app_surface"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Basic Information"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/app_text_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        app:dividerColor="@color/app_outline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Class name *"
                        android:textColor="@color/app_text_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:textSize="20dp"
                        />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/class_name_layout"
                        style="@style/Widget.App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Class Name *">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/class_name_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:singleLine="true"
                            tools:text="Móviles" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Course Code *"
                        android:textColor="@color/app_text_primary"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:textSize="20dp"
                        />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/course_code_layout"
                        style="@style/Widget.App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Course Code *">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/course_code_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:singleLine="true"
                            tools:text="ISIS 3510" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="168dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            >

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Section"
                                android:textColor="@color/app_text_primary"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"
                                android:textSize="20dp"
                                />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/section_layout"
                                style="@style/Widget.App.TextInput"
                                android:layout_width="160dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_marginTop="12dp"
                                android:layout_weight="1"
                                android:hint="Section">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/section_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:singleLine="true"
                                    tools:text="4" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="168dp"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            >

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="NRC"
                                android:textColor="@color/app_text_primary"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"
                                android:textSize="20dp"
                                />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/nrc_layout"
                                style="@style/Widget.App.TextInput"
                                android:layout_width="160dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:layout_marginTop="12dp"
                                android:hint="NRC">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/nrc_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:singleLine="true"
                                    tools:text="41886" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Instructor"
                        android:textColor="@color/app_text_primary"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:textSize="20dp"
                        />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/instructor_layout"
                        style="@style/Widget.App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Instructor Name">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/instructor_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:singleLine="true"
                            tools:text="Mario" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Schedule &amp; Recurrence"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/app_text_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        app:dividerColor="@color/app_outline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Days *"
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/app_text_primary" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/days_chip_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleLine="false"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_mo"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="MO" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_tu"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="TU" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_we"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="WE" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_th"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="TH" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_fr"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="FR" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sa"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="SA" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_su"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="SU" />
                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/start_time_layout"
                            style="@style/Widget.App.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:hint="Start Time"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_schedule">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/start_time_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:inputType="none"
                                android:singleLine="true"
                                android:text="08:00 AM" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/end_time_layout"
                            style="@style/Widget.App.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="End Time"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_schedule">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/end_time_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:inputType="none"
                                android:singleLine="true"
                                android:text="09:30 AM" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/start_date_layout"
                            style="@style/Widget.App.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:hint="Start Date"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_schedule">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/start_date_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:inputType="none"
                                android:singleLine="true"
                                tools:text="05/23/2026" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/until_date_layout"
                            style="@style/Widget.App.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="Until Date"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_schedule">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/until_date_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:inputType="none"
                                android:singleLine="true"
                                tools:text="09/23/2026" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Location"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/app_text_primary"
                        android:textStyle="bold" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        app:dividerColor="@color/app_outline" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="168dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            >

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Building Code *"
                                android:textColor="@color/app_text_primary"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"
                                android:textSize="20dp"
                                />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/building_code_layout"
                                style="@style/Widget.App.TextInput"
                                android:layout_width="160dp"
                                android:layout_marginTop="12dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:hint="Building Code *">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/building_code_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapCharacters"
                                    android:singleLine="true"
                                    tools:text="ML" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="168dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            >

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Room code"
                                android:textColor="@color/app_text_primary"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp"
                                android:textSize="20dp"
                                />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/room_code_layout"
                                style="@style/Widget.App.TextInput"
                                android:layout_marginTop="12dp"
                                android:layout_width="160dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:hint="Room Code">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/room_code_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapCharacters"
                                    android:singleLine="true"
                                    tools:text="ML 511" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_class_button"
                style="@style/Widget.App.Button.Primary"
                android:textSize="24dp"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="Save Class"
                android:textStyle="bold"
                app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
