<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_color"
        tools:context=".view.RouteActivity">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/coordinatorLayout"
            >

            <!-- App bar -->
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appbarlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fitsSystemWindows="true">

                <com.google.android.material.appbar.CollapsingToolbarLayout
                    style="?attr/collapsingToolbarLayoutMediumStyle"
                    android:id="@+id/collapsingtoolbarlayout"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/collapsingToolbarLayoutMediumSize"
                    app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
                    app:expandedTitleGravity="bottom|center_horizontal"
                    app:collapsedTitleTextColor="@color/black"
                    app:expandedTitleTextColor="@color/black"
                    app:collapsedSubtitleTextColor="@color/black"
                    app:expandedSubtitleTextColor="@color/black"
                    app:title="Navigation"
                    app:subtitle="Plan your Uniandes route"
                    android:background="@color/background_color"
                    >

                    <com.google.android.material.appbar.MaterialToolbar
                        android:id="@+id/toolbar"
                        style="@style/Widget.Material3.Toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="?attr/actionBarSize"
                        android:elevation="0dp"
                        app:layout_collapseMode="pin"
                        app:navigationIcon="@drawable/arrow_back_25dp_e3e3e3_fill0_wght400_grad0_opsz24"
                        app:navigationIconTint="@color/black"
                        android:background="@color/background_color"
                        app:titleTextColor="@color/black"
                        app:subtitleTextColor="@color/black"
                        />
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <!-- From to search -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/where_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:layout_constraintTop_toBottomOf="@+id/coordinatorLayout"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Where are we going?"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:textStyle="bold"
                    android:textSize="24dp"
                    android:textColor="@color/black"
                    />

                <!-- From -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/outlinedTextField_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:hint="From">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/outlinedTextField_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:hint="To">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Buttons Inside From to -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Search"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        style="?attr/materialButtonOutlinedStyle"
                        />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_swap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Swap"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        style="?attr/materialButtonOutlinedStyle"
                        />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->

        <com.google.android.material.button.MaterialButtonGroup
            android:id="@+id/buttonGroup_classes"
            style="@style/Widget.Material3.MaterialButtonGroup.Connected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/where_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            >
            <Button
                style="@style/Widget.App.Button.OutlinedButton"
                android:id="@+id/previous_class"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Previous Class"
                />
            <Button
                style="@style/Widget.App.Button.OutlinedButton"
                android:id="@+id/random_class"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Random"
                />
            <Button
                style="@style/Widget.App.Button.OutlinedButton"
                android:id="@+id/next_class"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next Class"
                />
        </com.google.android.material.button.MaterialButtonGroup>

        <!-- Route steps -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintTop_toBottomOf="@+id/buttonGroup_classes"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/scheduleLoadingIndicator"
                    style="@style/Widget.Material3Expressive.CircularProgressIndicator.Wavy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:layout_gravity="center"
                    app:indicatorColor="@color/primary_yellow"
                    app:indicatorSize="52dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:trackColor="@color/schedule_chip_background"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    tools:visibility="visible" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/view_on_map_button"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_height="wrap_content"
            android:text="View on map"
            app:layout_constraintTop_toBottomOf="@+id/card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="24dp"
            android:checkable="true"/>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
